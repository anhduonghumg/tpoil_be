model DocumentSequence {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid

  moduleCode String
  period     String
  currentNo  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleCode, period])
}

// =======================================
// Cron Jobs
// =======================================
model CronJob {
  id      String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  type    CronJobType @unique
  name    String
  enabled Boolean     @default(true)
  config  Json?

  runs CronJobRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CronJobRun {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid

  jobId String  @db.Uuid
  job   CronJob @relation(fields: [jobId], references: [id])

  runDate DateTime

  startedAt  DateTime
  finishedAt DateTime?

  status CronJobStatus

  metrics Json?
  error   String?

  createdAt DateTime @default(now())

  @@index([jobId, runDate])
}

model BackgroundJob {
  id      String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  type    BackgroundJobType @unique
  name    String
  enabled Boolean           @default(true)
  config  Json?

  runs BackgroundJobRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BackgroundJobRun {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid

  jobId String        @db.Uuid
  job   BackgroundJob @relation(fields: [jobId], references: [id])

  status BackgroundJobStatus @default(PENDING)

  payload Json?

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  metrics Json?
  error   String?

  createdAt DateTime @default(now())

  @@index([jobId, queuedAt])
  @@index([status, queuedAt])
}

model JobArtifact {
  id       String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  runId    String  @db.Uuid
  kind     String
  storage  String  @default("DB")
  content  Json?
  fileUrl  String?
  checksum String?

  createdAt DateTime @default(now())

  @@index([runId, kind])
  @@index([kind, createdAt])
}

// =======================================
// Auth (User)
// =======================================
model User {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  username    String    @unique
  email       String    @unique
  password    String
  name        String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee     Employee?
  roleBindings UserRoleBinding[]
  notificationRecipients NotificationRecipient[]
  notificationPreferences NotificationPreference[]
  notificationDevices NotificationDevice[]
  notificationWorkItems NotificationWorkItem[]
}

// =======================================
// Common Notification
// =======================================
model NotificationOutbox {
  id            String                   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String
  dedupeKey     String                   @unique
  payload       Json
  status        NotificationOutboxStatus @default(PENDING)
  attempts      Int                      @default(0)
  availableAt   DateTime                 @default(now()) @db.Timestamptz(6)
  lockedAt      DateTime?                @db.Timestamptz(6)
  processedAt   DateTime?                @db.Timestamptz(6)
  error         String?
  createdAt     DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                 @updatedAt @db.Timestamptz(6)

  notification Notification?

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}

model NotificationTemplate {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code          String   @unique
  moduleCode    String
  category      String
  titleTemplate String
  bodyTemplate  String
  defaultAction String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@index([moduleCode, category])
}

model Notification {
  id            String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  outboxId      String               @unique @db.Uuid
  eventType     String
  moduleCode    String
  category      String
  severity      NotificationSeverity @default(INFO)
  title         String
  body          String
  entityType    String?
  entityId      String?
  action        String?
  metadata      Json?
  occurredAt    DateTime             @default(now()) @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)

  outbox     NotificationOutbox       @relation(fields: [outboxId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipients NotificationRecipient[]

  @@index([moduleCode, category, createdAt])
  @@index([entityType, entityId])
}

model NotificationRecipient {
  id             String                      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  notificationId String                      @db.Uuid
  userId         String                      @db.Uuid
  status         NotificationRecipientStatus @default(UNREAD)
  readAt         DateTime?                   @db.Timestamptz(6)
  archivedAt     DateTime?                   @db.Timestamptz(6)
  createdAt      DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                    @updatedAt @db.Timestamptz(6)

  notification Notification          @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deliveries   NotificationDelivery[]

  @@unique([notificationId, userId])
  @@index([userId, status, createdAt])
}

model NotificationPreference {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId       String   @db.Uuid
  category     String
  inAppEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  emailEnabled Boolean  @default(false)
  muteUntil    DateTime? @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, category])
}

model NotificationDevice {
  id           String                   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId       String                   @db.Uuid
  platform     NotificationDevicePlatform
  pushProvider NotificationPushProvider?
  pushToken    String?                  @unique
  deviceId     String
  appVersion   String?
  locale       String?                  @default("vi-VN")
  enabled      Boolean                  @default(true)
  lastSeenAt   DateTime                 @default(now()) @db.Timestamptz(6)
  createdAt    DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @db.Timestamptz(6)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, deviceId])
  @@index([userId, enabled])
}

model NotificationDelivery {
  id                      String                     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  notificationRecipientId String                     @db.Uuid
  channel                 NotificationChannel
  deviceId                String?                    @db.Uuid
  status                  NotificationDeliveryStatus @default(PENDING)
  attemptCount            Int                        @default(0)
  providerMessageId       String?
  errorCode               String?
  sentAt                  DateTime?                  @db.Timestamptz(6)
  deliveredAt             DateTime?                  @db.Timestamptz(6)
  createdAt               DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                   @updatedAt @db.Timestamptz(6)

  recipient NotificationRecipient @relation(fields: [notificationRecipientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  device    NotificationDevice?    @relation(fields: [deviceId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, channel, createdAt])
  @@index([notificationRecipientId])
}

model NotificationWorkItem {
  id             String                     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId         String                     @db.Uuid
  sourceType     String
  sourceId       String
  action         String
  status         NotificationWorkItemStatus @default(OPEN)
  dueAt          DateTime?                  @db.Timestamptz(6)
  completedAt    DateTime?                  @db.Timestamptz(6)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                   @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, sourceType, sourceId, action])
  @@index([userId, status, dueAt])
}

// =======================================
// Employee - Hồ sơ nhân sự
// =======================================
model Employee {
  id   String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code String @unique

  userId String? @unique @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  fullName      String?
  phone         String?
  workEmail     String?
  personalEmail String?        @unique
  status        EmployeeStatus @default(active)
  gender        Gender?
  nationality   String?
  maritalStatus String?

  title String?
  grade String?
  floor Int?
  desk  String?

  siteId String? @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  managerId    String?    @db.Uuid
  manager      Employee?  @relation("EmpManagerLine", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("EmpManagerLine")

  dob      DateTime?
  joinedAt DateTime?
  leftAt   DateTime?

  avatarUrl    String?
  accessCardId String? @unique

  addressPermanent String?
  addressCurrent   String?

  banking   Json?
  citizen   Json?
  emergency Json?
  tax       Json?

  memberships  EmployeeDepartment[]
  managerRoles DepartmentManager[]

  customersSalesOwner      Party[] @relation("customer_sales_owner_emp")
  customersAccountingOwner Party[] @relation("customer_accounting_owner_emp")
  customersLegalOwner      Party[] @relation("customer_legal_owner_emp")
  customersDocumentOwner   Party[] @relation("customer_document_owner_emp")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([deletedAt])
  @@index([code])
}

// =======================================
// Danh mục Site / Area
// =======================================
model Area {
  id   String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code String @unique
  name String

  sites Site[]
}

model Site {
  id     String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code   String  @unique
  name   String
  areaId String? @db.Uuid
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  departments Department[]
  Employee    Employee[]
}

// =======================================
// Department – Phòng ban nhiều cấp
// =======================================
model Department {
  id   String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code String         @unique
  name String
  type DepartmentType

  parentId String?      @db.Uuid
  parent   Department?  @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children Department[] @relation("DeptHierarchy")

  siteId String? @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  costCenter String?

  members  EmployeeDepartment[]
  managers DepartmentManager[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([parentId])
  @@index([siteId])
  @@index([deletedAt])
}

// =======================================
// Liên kết nhân viên - phòng ban
// =======================================
model EmployeeDepartment {
  id           String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  employeeId   String @db.Uuid
  departmentId String @db.Uuid

  isPrimary Boolean   @default(false)
  startDate DateTime  @default(now())
  endDate   DateTime?

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, isPrimary])
  @@index([departmentId, startDate, endDate])
  @@index([employeeId, startDate, endDate])
}

// =======================================
// Quản lý trưởng/phó phòng
