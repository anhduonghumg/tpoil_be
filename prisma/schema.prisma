  label String

  rowType   PricingSheetRowType
  valueType PricingSheetValueType @default(NUMBER)

  inputValue      Decimal? @db.Decimal(18, 6)
  calculatedValue Decimal? @db.Decimal(18, 6)

  displayValue String?
  unit         String?
  formula      String?
  note         String?

  isInput       Boolean @default(false)
  isResult      Boolean @default(false)
  isBold        Boolean @default(false)
  isHighlighted Boolean @default(false)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stageId, rowNo])
  @@index([stageId])
  @@index([stageId, code])
  @@index([stageId, sortOrder])
}

model PriceBulletin {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid

  status PriceBulletinStatus @default(PUBLISHED)

  publishedAt   DateTime  @db.Timestamptz
  effectiveFrom DateTime  @db.Timestamptz
  effectiveTo   DateTime? @db.Timestamptz

  source       String?
  fileUrl      String?
  fileChecksum String?
  note         String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PriceBulletinItem[]

  @@unique([publishedAt])
  @@unique([fileChecksum])
  @@index([status, effectiveFrom])
  @@index([publishedAt])
}

model PriceBulletinItem {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid

  bulletinId String @db.Uuid
  productId  String @db.Uuid
  regionId   String @db.Uuid

  price Decimal @db.Decimal(18, 2)
  note  String?

  bulletin PriceBulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  region   PriceRegion   @relation(fields: [regionId], references: [id], onDelete: Restrict)

  @@unique([bulletinId, productId, regionId])
  @@index([productId, regionId])
}

// =======================================
// Audit Log
// =======================================
model AuditLog {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid

  requestId  String?  @db.Uuid
  at         DateTime @default(now())
  userId     String?  @db.Uuid
  ip         String?
  ua         String?
  method     String?
  path       String?
  statusCode Int?

  moduleCode String?
  permission String?
  action     String?
  entityId   String?    @db.Uuid
  scopeType  ScopeType?
  scopeId    String?    @db.Uuid

  before Json?
  after  Json?
  diff   Json?
  error  Json?

  @@index([userId, at])
  @@index([moduleCode, action, at])
  @@index([entityId])
}

// =======================================
// Export / Import Jobs
// =======================================
model ExportJob {
  id         String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  moduleCode String
  format     ExportFormat
  filter     Json?
  status     JobStatus    @default(queued)
  fileUrl    String?
  error      String?

  createdBy  String
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([moduleCode, status, createdBy, createdAt])
}

model ImportJob {
  id         String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  moduleCode String
  mode       ImportMode
  mapping    Json?
  status     JobStatus  @default(queued)
  total      Int?
  success    Int?
  failed     Int?
  srcFileUrl String?
  reportUrl  String?
  error      String?

  createdBy  String
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([moduleCode, status, createdBy, createdAt])
}

model LoginAttempt {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  username  String?
  email     String
  ok        Boolean
  ip        String?
  ua        String?
  createdAt DateTime @default(now())
}
