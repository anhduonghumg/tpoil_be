// ======================================================
// PURCHASE
// ======================================================
model PurchaseOrder {
  id            String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  legalEntityId String @db.Uuid
  orderNo       String

  supplierCustomerId String      @db.Uuid
  supplier           Party       @relation(fields: [supplierCustomerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  legalEntity        LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  priceRegionId String?      @db.Uuid
  priceRegion   PriceRegion? @relation(fields: [priceRegionId], references: [id], onDelete: SetNull)

  bizType     PurchaseBizType     @default(COMMERCIAL)
  orderType   PurchaseOrderType
  status      PurchaseOrderStatus @default(DRAFT)
  paymentMode PaymentMode
  currency    String              @default("VND") @db.Char(3)

  paymentTermType     PaymentTermType @default(SAME_DAY)
  paymentTermDays     Int?
  allowPartialPayment Boolean         @default(true)

  orderDate    DateTime
  expectedDate DateTime?

  paymentNote String?
  note        String?

  contractNo       String?
  contractId       String?   @db.Uuid
  contract         Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deliveryLocation String?

  // Retail commercial purchases answer a customer order raised by sales.
  salesOrderId String?     @db.Uuid
  salesOrder   SalesOrder? @relation("SalesOrderPurchaseOrders", fields: [salesOrderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  version      Int       @default(1)
  createdById  String?   @db.Uuid
  approvedById String?   @db.Uuid
  approvedAt   DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  lines       PurchaseOrderLine[]
  receipts    GoodsReceipt[]
  termProfile TermPurchaseProfile?

  supplierInvoices          SupplierInvoice[]
  paymentPlans              PurchaseOrderPaymentPlan[]
  pricingRuns               PurchasePricingRun[]
  shipments                 PurchaseShipment[]
  termLogisticsCosts        TermLogisticsCost[]
  termOrderDocuments        PurchaseTermOrderDocument[]
  termPaymentRequests       PurchaseTermPaymentRequest[]
  termBankInstructions      PurchaseTermBankInstruction[]
  termSettlementAdjustments PurchaseTermSettlementAdjustment[]
  termPaymentBatchItems     TermPaymentBatchItem[]
  shipCharterOrders         ShipCharterOrder[]
  shipCharterAppendices     ShipCharterAppendix[]
  landedCostDocuments       LandedCostDocument[]
  commercialLotWithdrawals  CommercialLotWithdrawal[]

  @@index([legalEntityId, orderNo])
  @@index([supplierCustomerId, orderDate])
  @@index([status])
  @@index([priceRegionId])
  @@index([bizType])
  @@index([contractId])
  @@index([salesOrderId])
}

model TermPurchaseProfile {
  purchaseOrderId  String               @id @db.Uuid
  premiumUsdPerBbl Decimal?             @db.Decimal(24, 8)
  transportMode    TermTransportMode
  charterRequired  Boolean              @default(false)
  flowType         TermPurchaseFlowType @default(ESTIMATE_FIRST)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model PurchaseOrderLine {
  id              String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  purchaseOrderId String @db.Uuid
  lineNo          Int
  productId       String @db.Uuid

  receivingWarehouseId String?    @db.Uuid
  receivingWarehouse   Warehouse? @relation(fields: [receivingWarehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  plannedReceivingAreaId String?        @db.Uuid
  plannedReceivingArea   WarehouseArea? @relation("PurchaseOrderLinePlannedArea", fields: [plannedReceivingAreaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  orderedQty Decimal  @db.Decimal(18, 3)
  actualReceivedQty Decimal? @db.Decimal(18, 3)
  unitPrice  Decimal? @db.Decimal(18, 2)
  taxRate    Decimal? @db.Decimal(5, 2)

  discountAmount Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  purchasePricingStageLines PurchasePricingStageLine[]
  termLogisticsCostLines    TermLogisticsCostLine[]
  expectedSupplies          ExpectedSupply[]
  shipmentLines             PurchaseShipmentLine[]
  receiptLines              GoodsReceiptLine[]
  supplierInvoiceLines      SupplierInvoiceLine[]
  commercialLotPosition     CommercialLotPosition?

  @@unique([purchaseOrderId, lineNo])
  @@index([purchaseOrderId])
  @@index([productId])
  @@index([receivingWarehouseId, productId])
  @@index([plannedReceivingAreaId, productId])
}

/// Commercial ownership and accounting position created when a LOT supplier invoice is posted.
/// Physical stock is posted only when a withdrawal is confirmed at a destination warehouse.
model CommercialLotPosition {
  id                  String                  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  purchaseOrderLineId String                  @unique @db.Uuid
  supplierCustomerId  String                  @db.Uuid
  plannedWarehouseId  String                  @db.Uuid
  productId           String                  @db.Uuid
  invoicedQty         Decimal                 @default(0) @db.Decimal(24, 6)
  withdrawnQty        Decimal                 @default(0) @db.Decimal(24, 6)
  accountingValue     Decimal                 @default(0) @db.Decimal(24, 4)
  stockState          CommercialLotStockState @default(EXPORTABLE)
  version             Int                     @default(1)
  createdAt           DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(6)

  purchaseOrderLine  PurchaseOrderLine                @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier           Party                            @relation("CommercialLotPositionSupplier", fields: [supplierCustomerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  plannedWarehouse   Warehouse                        @relation("CommercialLotPlannedWarehouse", fields: [plannedWarehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product            Product                          @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invoiceAllocations CommercialLotInvoiceAllocation[]
  withdrawalLines    CommercialLotWithdrawalLine[]

  @@index([supplierCustomerId, productId])
  @@index([plannedWarehouseId, productId])
  @@index([stockState])
}

model CommercialLotInvoiceAllocation {
  id                      String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  commercialLotPositionId String   @db.Uuid
  supplierInvoiceLineId   String   @unique @db.Uuid
  qty                     Decimal  @db.Decimal(24, 6)
  accountingValue         Decimal  @db.Decimal(24, 4)
  createdAt               DateTime @default(now()) @db.Timestamptz(6)

  commercialLotPosition CommercialLotPosition @relation(fields: [commercialLotPositionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplierInvoiceLine   SupplierInvoiceLine   @relation(fields: [supplierInvoiceLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([commercialLotPositionId])
}

model CommercialLotWithdrawal {
  id                     String                        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  purchaseOrderId        String                        @db.Uuid
  withdrawalNo           String
  destinationWarehouseId String                        @db.Uuid
  withdrawalDate         DateTime                      @db.Timestamptz(6)
  status                 CommercialLotWithdrawalStatus @default(DRAFT)
  note                   String?
  createdById            String?                       @db.Uuid
  confirmedById          String?                       @db.Uuid
  confirmedAt            DateTime?                     @db.Timestamptz(6)
  version                Int                           @default(1)
  createdAt              DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                      @updatedAt @db.Timestamptz(6)

  purchaseOrder        PurchaseOrder                 @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  destinationWarehouse Warehouse                     @relation("CommercialLotDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines                CommercialLotWithdrawalLine[]

  @@unique([purchaseOrderId, withdrawalNo])
  @@index([purchaseOrderId, status, withdrawalDate])
  @@index([destinationWarehouseId, withdrawalDate])
}

model CommercialLotWithdrawalLine {
  id                      String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  withdrawalId            String   @db.Uuid
  lineNo                  Int
  commercialLotPositionId String   @db.Uuid
  actualQty               Decimal  @db.Decimal(24, 6)
  v15Qty                  Decimal? @db.Decimal(24, 6)
  temperatureC            Decimal? @db.Decimal(8, 3)
  density                 Decimal? @db.Decimal(14, 8)
  goodsReceiptId          String?  @unique @db.Uuid

  withdrawal            CommercialLotWithdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  commercialLotPosition CommercialLotPosition   @relation(fields: [commercialLotPositionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  goodsReceipt          GoodsReceipt?           @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([withdrawalId, lineNo])
  @@index([commercialLotPositionId])
}

