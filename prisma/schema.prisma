  termPaymentBatchItems TermPaymentBatchItem[]

  isConfirmed Boolean   @default(false)
  confirmedAt DateTime?
  confirmedBy String?   @db.Uuid

  @@unique([bankAccountId, externalRef])
  @@unique([bankAccountId, fingerprint])
  @@index([bankAccountId, txnDate])
  @@index([matchStatus])
  @@index([externalRef])
  @@index([fingerprint])
  @@index([documentCode])
  @@index([purposeId])
  @@index([counterpartyId])
}

