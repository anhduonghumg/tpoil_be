  supplierLocationId String?           @db.Uuid
  supplierLocation   SupplierLocation? @relation(fields: [supplierLocationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  priceRegionId String?      @db.Uuid
  priceRegion   PriceRegion? @relation(fields: [priceRegionId], references: [id], onDelete: SetNull)

  bizType              PurchaseBizType      @default(COMMERCIAL)
  orderType            PurchaseOrderType
  status               PurchaseOrderStatus  @default(DRAFT)
  paymentMode          PaymentMode
  termPremiumUsdPerBbl Decimal?             @db.Decimal(18, 6)
  transportMode        TermTransportMode?
  charterVessel        Boolean              @default(false)
  termFlowType         TermPurchaseFlowType @default(ESTIMATE_FIRST)

  paymentTermType     PaymentTermType @default(SAME_DAY)
  paymentTermDays     Int?
  allowPartialPayment Boolean         @default(true)

  orderDate    DateTime
  expectedDate DateTime?

  paymentNote String?
  note        String?

  totalQty    Decimal? @db.Decimal(18, 3)
  totalAmount Decimal? @db.Decimal(18, 2)

  contractNo       String?
  contractId       String?   @db.Uuid
  contract         Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deliveryLocation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  supplierInvoices          SupplierInvoice[]                  @relation("supplierInvoices")
  paymentPlans              PurchaseOrderPaymentPlan[]
  pricingRuns               PurchasePricingRun[]
  termShipments             TermShipment[]
  termLogisticsCosts        TermLogisticsCost[]
  termOrderDocuments        PurchaseTermOrderDocument[]
  termPaymentRequests       PurchaseTermPaymentRequest[]
  termBankInstructions      PurchaseTermBankInstruction[]
  termSettlementAdjustments PurchaseTermSettlementAdjustment[]
  termPaymentBatchItems     TermPaymentBatchItem[]
  shipCharterOrders         ShipCharterOrder[]

  @@unique([orderNo])
  @@index([supplierCustomerId, orderDate])
  @@index([status])
  @@index([priceRegionId])
  @@index([bizType])
  @@index([contractId])
}

