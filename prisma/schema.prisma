model DocumentSequence {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid

  moduleCode String
  period     String
  currentNo  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleCode, period])
}

// =======================================
// Cron Jobs
// =======================================
model CronJob {
  id      String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  type    CronJobType @unique
  name    String
  enabled Boolean     @default(true)
  config  Json?

  runs CronJobRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CronJobRun {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid

  jobId String  @db.Uuid
  job   CronJob @relation(fields: [jobId], references: [id])

  runDate DateTime

  startedAt  DateTime
  finishedAt DateTime?

  status CronJobStatus

  metrics Json?
  error   String?

  createdAt DateTime @default(now())

  @@index([jobId, runDate])
}

model BackgroundJob {
  id      String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  type    BackgroundJobType @unique
  name    String
  enabled Boolean           @default(true)
  config  Json?

  runs BackgroundJobRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BackgroundJobRun {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid

  jobId String        @db.Uuid
  job   BackgroundJob @relation(fields: [jobId], references: [id])

  status BackgroundJobStatus @default(PENDING)

  payload Json?

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  metrics Json?
  error   String?

  createdAt DateTime @default(now())

  @@index([jobId, queuedAt])
  @@index([status, queuedAt])
}

model JobArtifact {
  id       String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  runId    String  @db.Uuid
  kind     String
  storage  String  @default("DB")
  content  Json?
  fileUrl  String?
  checksum String?

  createdAt DateTime @default(now())

  @@index([runId, kind])
  @@index([kind, createdAt])
}

// =======================================
// Auth (User)
// =======================================
model User {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  username    String    @unique
  email       String    @unique
  password    String
  name        String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee     Employee?
  roleBindings UserRoleBinding[]
}

// =======================================
// Employee – Hồ sơ nhân sự
// =======================================
model Employee {
  id   String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code String @unique

  userId String? @unique @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  fullName      String?
  phone         String?
  workEmail     String?
  personalEmail String?        @unique
  status        EmployeeStatus @default(active)
  gender        Gender?
  nationality   String?
  maritalStatus String?

  title String?
  grade String?
  floor Int?
  desk  String?

  siteId String? @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  managerId    String?    @db.Uuid
  manager      Employee?  @relation("EmpManagerLine", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("EmpManagerLine")

  dob      DateTime?
  joinedAt DateTime?
  leftAt   DateTime?

  avatarUrl    String?
  accessCardId String? @unique

  addressPermanent String?
  addressCurrent   String?

  banking   Json?
  citizen   Json?
  emergency Json?
  tax       Json?

  memberships  EmployeeDepartment[]
  managerRoles DepartmentManager[]

  customersSalesOwner      Customer[] @relation("customer_sales_owner_emp")
  customersAccountingOwner Customer[] @relation("customer_accounting_owner_emp")
  customersLegalOwner      Customer[] @relation("customer_legal_owner_emp")
  customersDocumentOwner   Customer[] @relation("customer_document_owner_emp")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([deletedAt])
  @@index([code])
}

// =======================================
// Danh mục Site / Area
// =======================================
model Area {
  id   String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code String @unique
  name String

  sites Site[]
}

model Site {
  id     String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code   String  @unique
  name   String
  areaId String? @db.Uuid
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  departments Department[]
  Employee    Employee[]
}

// =======================================
// Department – Phòng ban nhiều cấp
// =======================================
model Department {
  id   String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code String         @unique
  name String
  type DepartmentType

  parentId String?      @db.Uuid
  parent   Department?  @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children Department[] @relation("DeptHierarchy")

  siteId String? @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  costCenter String?

  members  EmployeeDepartment[]
  managers DepartmentManager[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([parentId])
  @@index([siteId])
  @@index([deletedAt])
}

// =======================================
// Liên kết nhân viên - phòng ban
// =======================================
model EmployeeDepartment {
  id           String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  employeeId   String @db.Uuid
  departmentId String @db.Uuid

  isPrimary Boolean   @default(false)
  startDate DateTime  @default(now())
  endDate   DateTime?

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, isPrimary])
  @@index([departmentId, startDate, endDate])
  @@index([employeeId, startDate, endDate])
}

// =======================================
// Quản lý trưởng/phó phòng
// =======================================
model DepartmentManager {
  id           String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  departmentId String      @db.Uuid
  employeeId   String      @db.Uuid
  role         ManagerRole
  startDate    DateTime    @default(now())
  endDate      DateTime?

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, startDate, endDate])
  @@index([employeeId, startDate, endDate])
  @@index([departmentId, role, startDate, endDate])
}

// =======================================
// RBAC + Scope
// =======================================
model Module {
  id          String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code        String       @unique
  name        String
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id        String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code      String           @unique
  name      String
  moduleId  String           @db.Uuid
  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roles     RolePermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([moduleId])
}

model Role {
  id        String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code      String            @unique
  name      String
  desc      String?
  perms     RolePermission[]
  bindings  UserRoleBinding[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleBinding {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  scopeType ScopeType
  scopeId   String?
  startAt   DateTime  @default(now())
  endAt     DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([scopeType, scopeId])
  @@index([startAt, endAt])
}

// =======================================
// Customer / Contract
// =======================================
model CustomerGroup {
  id   String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code String @unique

  name String?
  note String?

  customers Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([name])
}

model Customer {
  id          String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code        String     @unique
  name        String
  taxCode     String?
  taxVerified Boolean    @default(false)
  taxSource   TaxSource?
  taxSyncedAt DateTime?

  roles     CustomerRole[]
  type      CustomerType
  partyType PartyType      @default(CUSTOMER)

  groupId String?        @db.Uuid
  group   CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  billingAddress  String?
  shippingAddress String?
  contactEmail    String?
  contactPhone    String?

  creditLimit     Decimal?
  tempLimit       Decimal?
  tempFrom        DateTime?
  tempTo          DateTime?
  paymentTermDays Int?
  status          CustomerStatus @default(Active)
  note            String?

  isCustomer Boolean @default(true)
  isSupplier Boolean @default(false)
  isInternal Boolean @default(false)

  salesOwnerEmpId      String? @db.Uuid
  accountingOwnerEmpId String? @db.Uuid
  legalOwnerEmpId      String? @db.Uuid
  documentOwnerEmpId   String? @db.Uuid

  defaultPurchaseContractNo String?
  defaultDeliveryLocation   String?

  salesOwnerEmp      Employee? @relation("customer_sales_owner_emp", fields: [salesOwnerEmpId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  accountingOwnerEmp Employee? @relation("customer_accounting_owner_emp", fields: [accountingOwnerEmpId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  legalOwnerEmp      Employee? @relation("customer_legal_owner_emp", fields: [legalOwnerEmpId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  documentOwnerEmp   Employee? @relation("customer_document_owner_emp", fields: [documentOwnerEmpId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  contacts        ContactPerson[]
  contracts       Contract[]
  riskFlags       RiskFlag[]
  creditHistories CreditLimitHistory[]
  addresses       CustomerAddress[]

  vehicles                      Vehicle[]
  drivers                       Driver[]
  supplierLocations             SupplierLocation[]
  purchaseOrders                PurchaseOrder[]
  goodsReceipts                 GoodsReceipt[]
  supplierInvoices              SupplierInvoice[]
  settlements                   SupplierSettlement[]
  reconcileSessions             ReconcileSession[]
  adjustments                   InventoryAdjustment[]
  pricingTemplates              SupplierPricingTemplate[]
  pricingRuns                   PurchasePricingRun[]
  costLayers                    InventoryCostLayer[]
  termLogisticsCosts            TermLogisticsCost[]            @relation("term_logistics_cost_vendor")
  operationalRoles              CustomerOperationalRole[]
  ownedVessels                  Vessel[]                       @relation("vessel_owner")
  shipCharterContracts          ShipCharterContract[]          @relation("ship_charter_contract_owner")
  shipCharterOrders             ShipCharterOrder[]             @relation("ship_charter_order_owner")
  charterInsurances             ShipCharterInsurance[]         @relation("charter_insurance_company")
  charterInspections            ShipCharterInspection[]        @relation("charter_inspection_company")
  shippingAgentRegistrations    ShippingAgentRegistration[]    @relation("shipping_agent_company")
  shipFreightRates              ShipFreightRate[]              @relation("ship_freight_rate_owner")
  storageRentalContracts        StorageRentalContract[]        @relation("storage_rental_lessor")
  warehouseAvailabilityBalances WarehouseAvailabilityBalance[] @relation("availability_owner")
  warehouseAvailabilityLedgers  WarehouseAvailabilityLedger[]  @relation("availability_ledger_owner")
  expectedInventories           ExpectedInventory[]            @relation("expected_inventory_owner")

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  WarehouseReservation WarehouseReservation[]
  WarehouseTransfer    WarehouseTransfer[]

  @@index([name])
  @@index([taxCode])
  @@index([groupId])
  @@index([partyType])
  @@index([salesOwnerEmpId])
  @@index([accountingOwnerEmpId])
  @@index([legalOwnerEmpId])
  @@index([documentOwnerEmpId])
  @@index([isCustomer])
  @@index([isSupplier])
  @@index([isInternal])
}

model CustomerOperationalRole {
  id         String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  customerId String               @db.Uuid
  role       OperationalPartyRole
  isActive   Boolean              @default(true)
  note       String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([customerId, role])
  @@index([role, isActive])
}

model CustomerAddress {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  addressLine String
  validFrom   DateTime  @db.Date
  validTo     DateTime? @db.Date
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, validFrom])
  @@index([customerId, validTo])
  @@index([customerId])
}

model ContactPerson {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  fullName  String
  position  String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)
}

model Contract {
  id   String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code String @unique
  name String

  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  contractTypeId String       @db.Uuid
  contractType   ContractType @relation(fields: [contractTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  startDate DateTime
  endDate   DateTime

  status              ContractStatus @default(Draft)
  paymentTermDays     Int?
  creditLimitOverride Decimal?
  sla                 Json?
  deliveryScope       Json?
  riskLevel           RiskLevel      @default(Low)
  approvalRequestId   String?

  kind ContractKind @default(SALES)

  renewalOfId String?    @db.Uuid
  renewalOf   Contract?  @relation("ContractRenewal", fields: [renewalOfId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  renewals    Contract[] @relation("ContractRenewal")

  items          ContractItem[]
  appendices     ContractAppendix[]
  attachments    ContractAttachment[]
  purchaseOrders PurchaseOrder[]

