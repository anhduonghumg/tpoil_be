  isSystem         Boolean           @default(false)
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)

  transactions BankTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model BankAccount {
